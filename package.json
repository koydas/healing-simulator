{
  "name": "healing-simulator",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Mobile web party-healer simulator inspired by WoW Classic — React + TypeScript + Vite, no backend.",
  "license": "MIT",
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
